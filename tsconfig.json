{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "newLine": "lf",
    "outDir": "./lib",
    "rootDir": "./src",
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "useUnknownInCatchVariables": false,
    "baseUrl": ".",
    "paths": {
      "@docker/actions-toolkit/lib/context.js": ["src/shims/probe.ts"]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
